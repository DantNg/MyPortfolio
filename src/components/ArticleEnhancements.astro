---
/**
 * Ba tiện ích cho trang bài viết dài, gom vào một chỗ:
 *   1. Thanh tiến độ đọc ở đỉnh trang
 *   2. Nút copy cho mọi khối code (blog này rất nhiều code)
 *   3. Nút "lên đầu trang" hiện ra sau khi cuộn
 *
 * Đặt component này một lần trong layout bài viết. Tất cả đều là
 * progressive enhancement: không có JS thì trang vẫn đọc bình thường.
 */
---

<!-- 1. Thanh tiến độ đọc -->
<div
  id="read-progress"
  class="fixed top-0 left-0 h-0.5 bg-brand-600 z-[60] transition-[width] duration-75 ease-out"
  style="width:0"
  aria-hidden="true"
></div>

<!-- 3. Lên đầu trang -->
<button
  id="to-top"
  type="button"
  class="fixed bottom-5 right-5 z-50 w-11 h-11 rounded-full bg-white border border-zinc-300 shadow-lg text-zinc-600 flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 hover:text-brand-600 hover:border-brand-300"
  aria-label="Lên đầu trang / Back to top"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
  </svg>
</button>

<script>
  // ============ 1. Tiến độ đọc ============
  // Tính theo phần thân bài, không theo cả trang: khi đọc hết nội dung
  // thì thanh đầy, chứ không phải khi cuộn qua hết footer.
  const bar = document.getElementById('read-progress');
  const article = document.querySelector('article') ?? document.body;

  function updateProgress() {
    if (!bar) return;
    const rect = article.getBoundingClientRect();
    const total = rect.height - window.innerHeight;
    if (total <= 0) {
      bar.style.width = '0';
      return;
    }
    const passed = -rect.top;
    const pct = Math.min(100, Math.max(0, (passed / total) * 100));
    bar.style.width = pct + '%';
  }

  // ============ 3. Lên đầu trang ============
  const toTop = document.getElementById('to-top');

  function updateToTop() {
    if (!toTop) return;
    const show = window.scrollY > 600;
    toTop.classList.toggle('opacity-0', !show);
    toTop.classList.toggle('pointer-events-none', !show);
    toTop.classList.toggle('opacity-100', show);
  }

  toTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Một listener cho cả hai, tiết chế bằng requestAnimationFrame
  let queued = false;
  window.addEventListener(
    'scroll',
    () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        updateProgress();
        updateToTop();
        queued = false;
      });
    },
    { passive: true }
  );
  window.addEventListener('resize', updateProgress, { passive: true });
  updateProgress();
  updateToTop();

  // ============ 2. Nút copy cho khối code ============
  const COPY_ICON =
    '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" ' +
    'd="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>';
  const DONE_ICON =
    '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">' +
    '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>';

  document.querySelectorAll<HTMLPreElement>('.prose-custom pre').forEach((pre) => {
    // Bọc <pre> để đặt nút vào góc mà không phá layout cuộn ngang của nó
    const wrap = document.createElement('div');
    wrap.className = 'code-block group';
    pre.parentNode?.insertBefore(wrap, pre);
    wrap.appendChild(pre);

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'code-copy';
    btn.innerHTML = COPY_ICON + '<span>Copy</span>';
    btn.setAttribute('aria-label', 'Copy code');
    wrap.appendChild(btn);

    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
      try {
        await navigator.clipboard.writeText(code.replace(/\n$/, ''));
      } catch {
        // Trình duyệt cũ hoặc không có quyền: dùng cách cổ điển
        const ta = document.createElement('textarea');
        ta.value = code;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
        } catch {
          return; // thật sự không copy được — không đổi nhãn để khỏi nói dối
        }
        document.body.removeChild(ta);
      }

      btn.innerHTML = DONE_ICON + '<span>Đã copy</span>';
      btn.classList.add('is-done');
      setTimeout(() => {
        btn.innerHTML = COPY_ICON + '<span>Copy</span>';
        btn.classList.remove('is-done');
      }, 1600);
    });
  });
</script>
