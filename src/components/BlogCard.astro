---
/**
 * Thẻ bài viết trong danh sách blog.
 *
 * Bài không có ảnh bìa KHÔNG hiện ô xám trống nữa: thay vào đó là một dải
 * mảnh mang màu theo chủ đề, dựa trên tag đầu tiên. Vừa gọn hơn, vừa giúp
 * phân biệt bài theo mắt khi quét nhanh danh sách.
 */
import { formatDateShort } from '../utils/formatDate';
import { getReadingTime } from '../utils/readingTime';
import { url } from '../utils/url';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  slug: string;
  coverImage?: string;
  body: string;
  featured?: boolean;
}

const { title, description, date, tags, slug, coverImage, body, featured } = Astro.props;
const readingTime = getReadingTime(body);

/**
 * Màu dải trên theo chủ đề. Chọn theo tag đầu tiên khớp được, để cùng một
 * mảng đề tài thì luôn cùng màu qua các lần build.
 */
const ACCENTS: Record<string, string> = {
  rtos: 'from-brand-500 to-cyan-500',
  freertos: 'from-brand-500 to-cyan-500',
  zephyr: 'from-brand-500 to-cyan-500',
  linux: 'from-amber-500 to-orange-500',
  ble: 'from-violet-500 to-fuchsia-500',
  wireless: 'from-violet-500 to-fuchsia-500',
  lora: 'from-violet-500 to-fuchsia-500',
  esp32: 'from-emerald-500 to-teal-500',
  stm32: 'from-emerald-500 to-teal-500',
  c: 'from-zinc-400 to-zinc-500',
};

const accent =
  tags.map((t) => ACCENTS[t.toLowerCase()]).find(Boolean) ?? 'from-brand-500 to-brand-300';
---

<article
  class="group relative flex flex-col h-full rounded-2xl border border-zinc-200 bg-white overflow-hidden transition-all duration-300 hover:border-brand-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-zinc-900/[0.07]"
>
  {coverImage ? (
    <div class="cover-wrap aspect-video overflow-hidden bg-zinc-100 border-b border-zinc-200" data-accent={accent}>
      <img
        src={url(coverImage)}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    </div>
  ) : (
    <div class={`h-1 bg-gradient-to-r ${accent}`} aria-hidden="true"></div>
  )}

  <div class="flex flex-col flex-1 p-5 sm:p-6">
    <!-- meta -->
    <div class="flex items-center gap-2 text-xs text-zinc-500 mb-3">
      <time datetime={date.toISOString()}>{formatDateShort(date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime}</span>
      {featured && (
        <span class="ml-auto inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-brand-50 border border-brand-200 text-brand-700">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          Featured
        </span>
      )}
    </div>

    <h3 class="font-semibold text-zinc-900 text-lg mb-2 leading-snug group-hover:text-brand-700 transition-colors line-clamp-2">
      <a href={url(`/blog/${slug}`)} class="after:absolute after:inset-0">
        {title}
      </a>
    </h3>

    <p class="text-sm text-zinc-600 leading-relaxed flex-1 mb-4 line-clamp-3">{description}</p>

    <!-- tags + affordance -->
    <div class="flex items-end justify-between gap-3 mt-auto">
      <div class="flex flex-wrap gap-1.5 min-w-0">
        {tags.slice(0, 2).map((tag) => (
          <span class="tag">#{tag}</span>
        ))}
        {tags.length > 2 && <span class="tag">+{tags.length - 2}</span>}
      </div>

      <svg
        class="flex-shrink-0 w-4 h-4 text-zinc-300 group-hover:text-brand-600 group-hover:translate-x-0.5 transition-all"
        fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </div>
  </div>
</article>

<script>
  /* Anh bia 404 thi thu gon thanh dai mau chu de, thay vi de icon anh loi.
     Xu ly ca truong hop anh da loi truoc khi script chay (img.complete). */
  document.querySelectorAll<HTMLDivElement>('.cover-wrap').forEach((wrap) => {
    const img = wrap.querySelector('img');
    if (!img) return;

    const degrade = () => {
      wrap.classList.remove('aspect-video', 'bg-zinc-100', 'border-b', 'border-zinc-200');
      wrap.classList.add('h-1', 'bg-gradient-to-r');
      (wrap.dataset.accent ?? 'from-brand-500 to-brand-300')
        .split(' ')
        .forEach((c) => wrap.classList.add(c));
      img.remove();
    };

    if (img.complete && img.naturalWidth === 0) degrade();
    else img.addEventListener('error', degrade);
  });
</script>
