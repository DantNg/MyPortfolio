---
/**
 * Xử lý ngôn ngữ phía client.
 *
 * Site có hai loại trang, và script này phải phân biệt được:
 *
 *  1. Trang CÓ bản dịch riêng — `<html data-locale-locked="true">`.
 *     Ngôn ngữ do URL quyết định và server đã render sẵn đúng ngôn ngữ.
 *     Script KHÔNG được ghi đè nhãn theo localStorage, nếu không sẽ thành
 *     trang tiếng Việt mà nhãn giao diện lại là tiếng Anh. Việc duy nhất cần
 *     làm là ghi nhớ lựa chọn để trang trung tính sau đó theo đúng ý người
 *     dùng, và làm nổi bật nút đang chọn.
 *
 *  2. Trang KHÔNG có bản dịch (bài viết lẻ, dự án, about…). Nội dung là tiếng
 *     Anh, chỉ nhãn giao diện dịch được — đổi tại chỗ như trước, không tải lại.
 */
import { ui, defaultLang } from '../i18n';
---

<!-- Đặt sẵn ngôn ngữ trước khi vẽ để tránh nhấp nháy (FOUC) trên trang trung tính -->
<script is:inline define:vars={{ defaultLang }}>
  (function () {
    try {
      if (document.documentElement.dataset.localeLocked === 'true') return;
      const saved = localStorage.getItem('lang');
      if (saved && saved !== defaultLang) document.documentElement.lang = saved;
    } catch (e) {}
  })();
</script>

<script is:inline define:vars={{ ui, defaultLang }}>
  (function () {
    const html = document.documentElement;
    const locked = html.dataset.localeLocked === 'true';

    function markButtons(lang) {
      document.querySelectorAll('[data-lang-btn]').forEach(function (btn) {
        const active = btn.getAttribute('data-lang-btn') === lang;
        btn.classList.toggle('lang-active', active);
        btn.classList.toggle('text-zinc-600', !active);
        if (btn.tagName === 'BUTTON') btn.setAttribute('aria-pressed', String(active));
      });
    }

    /* ---------- Trang có URL riêng theo ngôn ngữ ---------- */
    if (locked) {
      const pageLang = html.lang || defaultLang;
      /* Ghi nhớ để trang trung tính tiếp theo hiển thị đúng ngôn ngữ người
         dùng vừa chọn bằng cách bấm link EN/VI. */
      try { localStorage.setItem('lang', pageLang); } catch (e) {}
      markButtons(pageLang);
      return;   // nhãn đã đúng từ server — không sửa gì thêm
    }

    /* ---------- Trang trung tính: đổi nhãn tại chỗ ---------- */
    function applyLang(lang) {
      const dict = ui[lang] || ui[defaultLang];
      html.lang = lang;

      document.querySelectorAll('[data-i18n]').forEach(function (el) {
        const key = el.getAttribute('data-i18n');
        if (dict[key] != null) el.innerHTML = dict[key];
      });
      document.querySelectorAll('[data-i18n-ph]').forEach(function (el) {
        const key = el.getAttribute('data-i18n-ph');
        if (dict[key] != null) el.setAttribute('placeholder', dict[key]);
      });
      document.querySelectorAll('[data-i18n-aria]').forEach(function (el) {
        const key = el.getAttribute('data-i18n-aria');
        if (dict[key] != null) el.setAttribute('aria-label', dict[key]);
      });

      markButtons(lang);
      try { localStorage.setItem('lang', lang); } catch (e) {}
    }

    function getLang() {
      try { return localStorage.getItem('lang') || defaultLang; } catch (e) { return defaultLang; }
    }

    applyLang(getLang());

    document.addEventListener('click', function (e) {
      const btn = e.target.closest('button[data-lang-btn]');
      if (!btn) return;
      applyLang(btn.getAttribute('data-lang-btn'));
    });

    window.__applyLang = applyLang;
  })();
</script>
