---
/** Dải giới thiệu series LVGL trên trang chủ. Song ngữ qua data-i18n. */
import { getCollection } from 'astro:content';
import { t } from '../i18n';
import { url } from '../utils/url';

const all = await getCollection('lvgl', (e) => !e.data.draft);
const count = new Set(all.map((e) => e.data.lesson)).size;
const first = all
  .filter((e) => e.data.lang === 'en')
  .sort((a, b) => a.data.lesson - b.data.lesson)[0];
const firstSlug = first?.slug.split('/').pop();
---

<section class="py-16 md:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="relative overflow-hidden rounded-2xl border border-brand-200 bg-brand-50/60 px-6 py-10 md:px-12 md:py-12"
      data-animate
    >
      <div class="absolute inset-0 bg-pcb opacity-40 pointer-events-none" aria-hidden="true"></div>

      <div class="relative flex flex-col lg:flex-row lg:items-center gap-8">
        <div class="flex-1 min-w-0">
          <p class="inline-flex items-center gap-2 text-brand-600 font-mono text-sm mb-3 tracking-widest uppercase" data-i18n="lvgl.eyebrow">
            <span class="led text-emerald-500 animate-led-blink-fast"></span>{t('lvgl.eyebrow')}
          </p>

          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-zinc-900 mb-3" data-i18n="lvgl.heading">
            {t('lvgl.heading')}
          </h2>

          <p class="text-zinc-600 leading-relaxed max-w-2xl" data-i18n="lvgl.subheading">
            {t('lvgl.subheading')}
          </p>

          <div class="flex flex-wrap items-center gap-2 mt-5 text-xs font-mono">
            <span class="tag">{count} <span data-i18n="lvgl.meta.lessons">{t('lvgl.meta.lessons')}</span></span>
            <span class="tag" data-i18n="lvgl.meta.bilingual">{t('lvgl.meta.bilingual')}</span>
            <span class="tag" data-i18n="lvgl.meta.code">{t('lvgl.meta.code')}</span>
          </div>
        </div>

        <div class="flex-shrink-0">
          <a href={firstSlug ? url(`/lvgl/${firstSlug}`) : url('/lvgl')} class="btn-primary text-base px-6 py-3">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
            </svg>
            <span data-i18n="lvgl.cta.start">{t('lvgl.cta.start')}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
