---
/**
 * Mục lục cho màn hình nhỏ.
 *
 * Sidebar TOC chỉ hiện từ breakpoint `lg` trở lên, nên trên điện thoại một
 * bài học 400 dòng hoàn toàn không có cách nào nhảy tới mục cần đọc.
 * Component này là một <details> gập lại, chỉ hiện dưới `lg`.
 */
import { t, type Lang } from '../i18n';

interface Props {
  headings: { depth: number; slug: string; text: string }[];
  lang?: Lang;
}

const { headings, lang = 'en' } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{items.length > 2 && (
  <details class="toc-mobile lg:hidden mb-8 rounded-xl border border-zinc-200 bg-zinc-50 px-4 py-3">
    <summary class="flex items-center justify-between gap-2 text-sm font-medium text-zinc-700">
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
        </svg>
        <span>{t('toc.heading', lang)}</span>
        <span class="text-zinc-400 font-normal">({items.length})</span>
      </span>
      <svg class="toc-chevron w-4 h-4 text-zinc-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>

    <ol class="mt-3 pt-3 border-t border-zinc-200 space-y-1.5">
      {items.map((h, i) => (
        <li class="flex gap-2.5">
          <span class="text-xs font-mono text-zinc-400 pt-0.5 flex-shrink-0 tabular-nums">
            {String(i + 1).padStart(2, '0')}
          </span>
          <a
            href={`#${h.slug}`}
            class="text-sm text-zinc-600 hover:text-brand-600 transition-colors leading-snug"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ol>
  </details>
)}

<script>
  // Bấm vào một mục thì gập lại — nếu để mở, người đọc phải cuộn qua
  // cả cái mục lục mới tới được nội dung.
  document.querySelectorAll<HTMLDetailsElement>('.toc-mobile').forEach((el) => {
    el.querySelectorAll('a[href^="#"]').forEach((a) => {
      a.addEventListener('click', () => { el.open = false; });
    });
  });
</script>
