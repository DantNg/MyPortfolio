---
/** Thẻ giới thiệu một series. Dùng ở trang chủ (blog hub). */
import type { SeriesMeta } from '../series';
import { getSeriesLessons } from '../utils/seriesData';
import { t, type Lang } from '../i18n';
import { url } from '../utils/url';
import { localeUrl } from '../utils/i18nUrl';

interface Props {
  meta: SeriesMeta;
  lang?: Lang;
}

const { meta, lang = 'en' } = Astro.props;
const lessons = await getSeriesLessons(meta.id);
const seriesUrl = localeUrl(`/blog/series/${meta.id}`, lang);
---

<a
  href={seriesUrl}
  class="group relative flex flex-col rounded-2xl border border-zinc-200 bg-white overflow-hidden transition-all duration-300 hover:border-brand-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-zinc-900/5"
>
  <!--
    Thumbnail. Chữ trên ảnh cố tình chỉ dùng thuật ngữ kỹ thuật và tiếng Anh
    ngắn: cùng một ảnh phục vụ cả bản `/` lẫn `/vi/`, nên nhãn tiếng Việt sẽ
    lệch ngữ cảnh ở một trong hai bên.

    alt="" vì tiêu đề series nằm ngay dưới — đọc lại nội dung ảnh chỉ làm trình
    đọc màn hình lặp lại thông tin đã có.
  -->
  <div class="series-cover aspect-[1200/630] overflow-hidden bg-zinc-50 border-b border-zinc-200">
    <img
      src={url(meta.thumbnail)}
      alt=""
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="flex flex-col flex-1 p-5 sm:p-6">
    <div class="flex items-start gap-4">
      <span class="flex-shrink-0 inline-flex items-center justify-center w-11 h-11 rounded-xl bg-brand-50 border border-brand-200 text-brand-600 group-hover:bg-brand-600 group-hover:text-white group-hover:border-brand-600 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={meta.iconPath} />
        </svg>
      </span>

      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-[11px] font-mono uppercase tracking-widest text-brand-600">{t('series.label', lang)}</span>
          <span class="text-[11px] font-mono text-zinc-400" aria-hidden="true">·</span>
          <span class="text-[11px] font-mono text-zinc-500">
            {lessons.length} <span>{t('series.meta.lessons', lang)}</span>
          </span>
        </div>

        <h3 class="font-semibold text-lg text-zinc-900 leading-snug group-hover:text-brand-700 transition-colors">
          {meta.title[lang]}
        </h3>
      </div>
    </div>

    <p class="text-sm text-zinc-600 leading-relaxed mt-4 flex-1">
      {meta.tagline[lang]}
    </p>

    <!-- các bài đầu tiên, xem trước -->
    <ul class="mt-4 space-y-1.5 text-sm text-zinc-500">
      {lessons.slice(0, 3).map((l) => (
        <li class="flex gap-2 min-w-0">
          <span class="font-mono text-xs text-zinc-400 pt-0.5">{String(l.lesson).padStart(2, '0')}</span>
          <span class="truncate">
            {l[lang]?.data.title ?? l.en?.data.title}
          </span>
        </li>
      ))}
      {lessons.length > 3 && (
        <li class="text-xs text-zinc-400 pl-7">+ {lessons.length - 3}</li>
      )}
    </ul>

    <span class="inline-flex items-center gap-1.5 text-sm font-medium text-brand-600 mt-5 group-hover:gap-2.5 transition-all">
      <span>{t('series.cta.open', lang)}</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </span>
  </div>
</a>

<script>
  /* Thumbnail 404 thì thu khung ảnh về một dải mảnh, thay vì để icon ảnh lỗi
     chiếm nguyên khối 1200×630. Cùng cách xử lý như ảnh bìa bài viết. */
  document.querySelectorAll<HTMLDivElement>('.series-cover').forEach((wrap) => {
    const img = wrap.querySelector('img');
    if (!img) return;

    const degrade = () => {
      wrap.classList.remove('aspect-[1200/630]', 'bg-zinc-50');
      wrap.classList.add('h-1', 'bg-brand-500');
      img.remove();
    };

    if (img.complete && img.naturalWidth === 0) degrade();
    else img.addEventListener('error', degrade);
  });
</script>
