---
/**
 * Trang tổng quan một series, render ĐÚNG MỘT ngôn ngữ.
 *
 * Bản tiếng Anh ở /blog/series/<id>, bản tiếng Việt ở /vi/blog/series/<id>.
 * Cả hai route dùng chung component này nên không thể lệch nhau về bố cục.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import type { SeriesMeta } from '../series';
import { getSeriesLessons } from '../utils/seriesData';
import { t, type Lang } from '../i18n';
import { localeUrl } from '../utils/i18nUrl';
import { url } from '../utils/url';
import StructuredData from './StructuredData.astro';

interface Props {
  lang: Lang;
  meta: SeriesMeta;
}

const { lang, meta } = Astro.props;
const lessons = await getSeriesLessons(meta.id);

const allTags = [
  ...new Set(lessons.flatMap((l) => l.en?.data.tags ?? [])),
];
---

<BaseLayout lang={lang} title={meta.title[lang]} description={meta.intro[lang]} tags={allTags}>
  <StructuredData
    slot="head"
    kind="collection"
    headline={meta.title[lang]}
    description={meta.intro[lang]}
    crumbs={[
      { name: t('nav.blog', lang), path: '/' },
      { name: meta.title[lang], path: `/blog/series/${meta.id}` },
    ]}
  />
  <section class="pt-28 pb-14 md:pt-32 md:pb-16 relative overflow-hidden">
    <div class="absolute inset-0 bg-pcb opacity-30 pointer-events-none" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-radial-glow pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-zinc-500 mb-8">
        <a href={localeUrl('/', lang)} class="hover:text-brand-600 transition-colors">{t('nav.blog', lang)}</a>
        <span>/</span>
        <a href={url('/blog#series')} class="hover:text-brand-600 transition-colors">{t('series.label', lang)}</a>
        <span>/</span>
        <span class="text-zinc-700">{meta.badge}</span>
      </nav>

      <div class="text-center">
        <p class="inline-flex items-center gap-2 text-brand-600 font-mono text-sm mb-4 tracking-widest uppercase">
          <span class="led text-emerald-500 animate-led-blink-fast"></span>{t('series.eyebrow', lang)}
        </p>

        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 text-balance mb-5">
          {meta.title[lang]}
        </h1>

        <p class="text-lg text-zinc-600 leading-relaxed max-w-2xl mx-auto">
          {meta.intro[lang]}
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3 mt-8 text-sm">
          <span class="tag">{lessons.length} <span>{t('series.meta.lessons', lang)}</span></span>
          <span class="tag">{t('series.meta.bilingual', lang)}</span>
          <span class="tag">{t('series.meta.code', lang)}</span>
        </div>

        {lessons.length > 0 && (
          <div class="mt-8">
            <a href={localeUrl(`/blog/series/${meta.id}/${lessons[0].slug}`, lang)} class="btn-primary text-base px-6 py-3">
              <span>{t('series.cta.start', lang)}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Who / What -->
  <section class="pb-4">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid sm:grid-cols-2 gap-4">
      <div class="card">
        <h2 class="font-semibold text-zinc-900 mb-2">{t('series.who.title', lang)}</h2>
        <p class="text-sm text-zinc-600 leading-relaxed">
          {meta.audience[lang]}
        </p>
      </div>
      <div class="card">
        <h2 class="font-semibold text-zinc-900 mb-2">{t('series.need.title', lang)}</h2>
        <p class="text-sm text-zinc-600 leading-relaxed">
          {meta.requirements[lang]}
        </p>
      </div>
    </div>
  </section>

  <!-- Lesson list -->
  <section class="py-14 md:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-zinc-900 mb-8">{t('series.toc', lang)}</h2>

      <ol class="space-y-3.5">
        {lessons.map((l) => (
          <li>
            <a
              href={localeUrl(`/blog/series/${meta.id}/${l.slug}`, lang)}
              class="group flex gap-5 rounded-2xl border border-zinc-200 bg-white p-5 sm:p-6 transition-all duration-300 hover:border-brand-300 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-zinc-900/5"
            >
              <span class="flex-shrink-0 w-11 h-11 rounded-xl bg-brand-50 border border-brand-200 text-brand-700 font-mono font-bold flex items-center justify-center group-hover:bg-brand-600 group-hover:text-white group-hover:border-brand-600 transition-colors">
                {String(l.lesson).padStart(2, '0')}
              </span>

              <span class="min-w-0 flex-1">
                <span class="block font-semibold text-zinc-900 leading-snug group-hover:text-brand-700 transition-colors">
                  {l[lang]?.data.title ?? l.en?.data.title}
                </span>

                <span class="block text-sm text-zinc-600 leading-relaxed mt-1.5">
                  {l[lang]?.data.description ?? l.en?.data.description}
                </span>

                <span class="flex flex-wrap items-center gap-2 mt-3 text-xs text-zinc-500 font-mono">
                  <span class="inline-flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    {l[lang]?.data.duration ?? l.en?.data.duration}
                  </span>
                  {(l.en?.data.tags ?? []).slice(0, 3).map((tag: string) => (
                    <span class="px-2 py-0.5 rounded bg-zinc-100 text-zinc-600">{tag}</span>
                  ))}
                </span>
              </span>

              <svg class="hidden sm:block flex-shrink-0 w-5 h-5 text-zinc-300 self-center group-hover:text-brand-600 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </li>
        ))}
      </ol>

      <div class="mt-12">
        <a href={localeUrl('/', lang)} class="btn-secondary inline-flex">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>{t('common.backArticles', lang)}</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
