---
import { t } from '../i18n';

const skillCategories = [
  {
    nameKey: 'skills.cat.embedded',
    name: 'Embedded Systems',
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/></svg>`,
    color: 'brand',
    skills: ['STM32', 'ESP32', 'FreeRTOS', 'Embedded Linux', 'Bare-metal'],
  },
  {
    name: 'Connectivity',
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"/></svg>`,
    color: 'cyan',
    nameKey: 'skills.cat.connectivity',
    skills: ['UART', 'SPI', 'I2C', 'CAN', 'RS485', 'BLE 5.0', 'WiFi', 'LoRa'],
  },
  {
    name: 'Linux & Software',
    nameKey: 'skills.cat.linux',
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`,
    color: 'emerald',
    skills: ['C / C++', 'Python', 'OOP', 'Multi-threading', 'IPC (Binder)'],
  },
  {
    name: 'Tools & Platforms',
    nameKey: 'skills.cat.drone',
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    color: 'violet',
    skills: ['Git', 'Jenkins', 'Jira', 'Codebeamer', 'Qt Creator'],
  },
];

const colorMap: Record<string, { bg: string; border: string; text: string; iconBg: string }> = {
  brand: { bg: 'bg-brand-50', border: 'border-brand-200', text: 'text-brand-700', iconBg: 'bg-brand-50 text-brand-600 border-brand-200' },
  cyan: { bg: 'bg-cyan-50', border: 'border-cyan-200', text: 'text-cyan-700', iconBg: 'bg-cyan-50 text-cyan-600 border-cyan-200' },
  emerald: { bg: 'bg-emerald-50', border: 'border-emerald-200', text: 'text-emerald-700', iconBg: 'bg-emerald-50 text-emerald-600 border-emerald-200' },
  violet: { bg: 'bg-violet-50', border: 'border-violet-200', text: 'text-violet-700', iconBg: 'bg-violet-50 text-violet-600 border-violet-200' },
};
---

<section id="skills" class="relative py-24 md:py-32 overflow-hidden">
  <div class="absolute inset-0 bg-pcb opacity-30 pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16" data-animate>
      <p class="inline-flex items-center gap-2 text-cyan-600 font-mono text-sm mb-3 tracking-widest uppercase" data-i18n="skills.eyebrow"><span class="led text-cyan-600 animate-led-blink"></span>{t('skills.eyebrow')}</p>
      <h2 class="section-heading" data-i18n="skills.heading">{t('skills.heading')}</h2>
      <p class="section-subheading max-w-2xl mx-auto" data-i18n="skills.subheading">
        {t('skills.subheading')}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {skillCategories.map((category, i) => {
        const colors = colorMap[category.color];
        return (
          <div
            class={`relative rounded-2xl border p-6 ${colors.bg} ${colors.border} transition-all duration-300 hover:-translate-y-1 hover:shadow-xl group`}
            data-animate
            style={`animation-delay: ${i * 100}ms`}
          >
            <!-- Icon -->
            <div class={`inline-flex items-center justify-center w-10 h-10 rounded-xl border ${colors.iconBg} mb-4`} set:html={category.icon} />

            <h3 class="font-semibold text-zinc-900 mb-4" data-i18n={category.nameKey}>{t(category.nameKey)}</h3>

            <ul class="space-y-2">
              {category.skills.map(skill => (
                <li class="flex items-center gap-2.5">
                  <span class={`w-1.5 h-1.5 rounded-full ${colors.text.replace('text', 'bg')}`}></span>
                  <span class="text-sm text-zinc-700">{skill}</span>
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>

    <!-- Tool proficiency bar section -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8" data-animate>
      {[
        { name: 'C / C++', level: 92 },
        { name: 'STM32 / Bare-metal', level: 88 },
        { name: 'FreeRTOS', level: 85 },
        { name: 'Embedded Linux / Middleware', level: 82 },
        { name: 'IPC (Binder) / Multi-threading', level: 80 },
        { name: 'Python', level: 75 },
      ].map(item => (
        <div>
          <div class="flex justify-between items-center mb-1.5">
            <span class="text-sm font-medium text-zinc-700">{item.name}</span>
            <span class="text-xs text-zinc-500 font-mono">{item.level}%</span>
          </div>
          <div class="h-1.5 bg-zinc-100 rounded-full overflow-hidden">
            <div
              class="skill-bar h-full bg-gradient-to-r from-brand-500 to-cyan-500 rounded-full"
              style="width:0%"
              data-width={item.level}
            ></div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <script>
    const bars = document.querySelectorAll('.skill-bar');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          const el = e.target as HTMLElement;
          el.style.transition = 'width 1.4s cubic-bezier(0.16,1,0.3,1)';
          el.style.width = (el.dataset.width || '0') + '%';
          io.unobserve(el);
        }
      });
    }, { threshold: 0.4 });
    bars.forEach((b) => io.observe(b));
  </script>
</section>
