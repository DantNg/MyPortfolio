---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../utils/formatDate';
import { getReadingTime } from '../utils/readingTime';
import { url } from '../utils/url';
import TableOfContents from '../components/TableOfContents.astro';
import ViewCounter from '../components/ViewCounter.astro';
import MobileToc from '../components/MobileToc.astro';
import ArticleEnhancements from '../components/ArticleEnhancements.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    date: Date;
    updatedDate?: Date;
    tags: string[];
    coverImage?: string;
  };
  headings: { depth: number; slug: string; text: string }[];
  rawContent: string;
}

const { frontmatter, headings, rawContent } = Astro.props;
const readingTime = getReadingTime(rawContent);
const hasToc = headings.filter(h => h.depth <= 3).length > 2;

/**
 * Ảnh cho thẻ Open Graph.
 *
 * Hai lỗi được sửa ở đây:
 *   1. `coverImage` trong frontmatter là đường dẫn KHÔNG có base (`/images/...`),
 *      nên trước đây og:image trỏ tới dantng.github.io/images/... — thiếu
 *      /MyPortfolio và 404. Phải đi qua url().
 *   2. Bộ đọc OG của Facebook/X/LinkedIn KHÔNG render SVG. Ảnh bìa hiển thị là
 *      SVG, nên ở đây ta trỏ sang bản PNG cùng tên do `npm run thumbnails` sinh ra.
 */
const ogImage = frontmatter.coverImage
  ? url(frontmatter.coverImage.replace(/\.svg$/, '.png'))
  : undefined;

---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  image={ogImage}
  type="article"
  publishedTime={frontmatter.date.toISOString()}
  tags={frontmatter.tags}
>
  <article class="py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <header class="text-center mb-12">
        <div class="flex items-center justify-center gap-3 text-sm text-zinc-500 mb-4">
          <time datetime={frontmatter.date.toISOString()}>
            {formatDate(frontmatter.date)}
          </time>
          <span>·</span>
          <span>{readingTime}</span>
          <ViewCounter />
        </div>

        <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-zinc-900 text-balance mb-6">
          {frontmatter.title}
        </h1>

        <p class="text-xl text-zinc-600 leading-relaxed">
          {frontmatter.description}
        </p>

        <div class="flex flex-wrap items-center justify-center gap-2 mt-6">
          {frontmatter.tags.map(tag => (
            <a href={url(`/blog?tag=${tag}`)} class="tag hover:bg-brand-100 transition-colors">
              #{tag}
            </a>
          ))}
        </div>
      </header>

      {frontmatter.coverImage && (
        <div class="mb-12 rounded-2xl overflow-hidden border border-zinc-200">
          <img
            src={url(frontmatter.coverImage)}
            alt={frontmatter.title}
            class="w-full object-cover aspect-video"
            loading="eager"
          />
        </div>
      )}

      <!-- Content with optional TOC -->
      <div class={hasToc ? 'lg:grid lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-14' : ''}>
        <div class="min-w-0">
          <MobileToc headings={headings} />
          <div class="prose prose-zinc max-w-none prose-custom">
            <slot />
          </div>
        </div>

        {hasToc && (
          <aside class="hidden lg:block">
            <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
              <TableOfContents headings={headings} />
            </div>
          </aside>
        )}
      </div>

      <!-- Footer nav -->
      <div class="mt-16 pt-8 border-t border-zinc-200">
        <a href={url('/blog')} class="btn-secondary inline-flex">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span data-i18n="common.backArticles">Back to all articles</span>
        </a>
      </div>
    </div>
  </article>

  <ArticleEnhancements />
</BaseLayout>
