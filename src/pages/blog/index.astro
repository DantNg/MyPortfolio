---
/**
 * Chuyển hướng: /blog -> /
 *
 * Blog giờ chính là trang chủ. Giữ URL này để mọi link đã chia sẻ trước đây
 * không chết, và để `canonical` dồn uy tín về `/` thay vì chia đôi giữa hai
 * URL có cùng nội dung (duplicate content).
 *
 * Trang này bị loại khỏi sitemap (xem filter trong astro.config.mjs) và đánh
 * noindex — đưa một URL chuyển hướng vào chỉ mục là tự tạo trang rác.
 */
import { url } from '../../utils/url';

const target = url('/');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Blog — redirecting…</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body>
    <p>The blog is now the home page. Redirecting to <a href={target}>{target}</a>…</p>
    <script is:inline define:vars={{ target }}>window.location.replace(target);</script>
  </body>
</html>
