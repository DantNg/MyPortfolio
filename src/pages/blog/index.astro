---
/**
 * Trang Blog: các series học tập + bài viết lẻ.
 *
 * LỌC VÀ TÌM KIẾM CHẠY Ở CLIENT.
 * Trước đây trang này đọc `Astro.url.searchParams` — nhưng site build tĩnh,
 * nên tham số truy vấn chỉ được đọc lúc BUILD (khi đó nó luôn rỗng).
 * Kết quả là `/blog?tag=BLE` trả về đúng trang gốc, không lọc gì cả.
 * Giờ toàn bộ bài viết được render sẵn kèm data-attribute, còn việc lọc
 * do JS làm — vẫn hoạt động khi chia sẻ link có ?tag=, và không cần server.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import SeriesCard from '../../components/SeriesCard.astro';
import { getCollection } from 'astro:content';
import { SERIES } from '../../series';
import { t } from '../../i18n';
import { url } from '../../utils/url';

const seriesList = [...SERIES].sort((a, b) => a.order - b.order);

const allPosts = await getCollection('blog', (p) => !p.data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

/** Đếm số bài theo từng tag để hiện ngay trên chip lọc */
const tagCounts = new Map<string, number>();
for (const p of posts) {
  for (const tg of p.data.tags) tagCounts.set(tg, (tagCounts.get(tg) ?? 0) + 1);
}
const allTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

/** Số bài hiện ban đầu; nút "xem thêm" mở dần từng lô này */
const PAGE_SIZE = 9;
---

<BaseLayout
  title="Blog"
  description="Technical articles and bilingual learning series on embedded systems, RTOS, Linux, automotive software and firmware architecture."
>
  <div class="pt-28 pb-20 md:pt-32 md:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- ===== Header ===== -->
      <div class="max-w-2xl mb-14" data-animate>
        <p class="text-brand-600 font-mono text-sm mb-3 tracking-widest uppercase" data-i18n="blog.eyebrow">
          {t('blog.eyebrow')}
        </p>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 mb-4">Blog</h1>
        <p class="text-lg sm:text-xl text-zinc-600 leading-relaxed" data-i18n="blog.subheading">
          {t('blog.subheading')}
        </p>
      </div>

      <!-- ===== Learning series ===== -->
      {seriesList.length > 0 && (
        <section id="series" class="mb-16 scroll-mt-24" data-animate>
          <div class="flex items-center gap-3 mb-2">
            <h2 class="text-2xl font-bold tracking-tight text-zinc-900" data-i18n="series.sectionHeading">
              {t('series.sectionHeading')}
            </h2>
            <span class="px-2 py-0.5 rounded-md bg-brand-50 border border-brand-200 text-brand-700 text-xs font-mono">
              {seriesList.length}
            </span>
          </div>
          <p class="text-zinc-600 mb-6 max-w-2xl leading-relaxed" data-i18n="series.sectionSub">
            {t('series.sectionSub')}
          </p>

          <div id="series-grid" class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6">
            {seriesList.map((s) => (
              <div
                class="series-item"
                data-text={`${s.badge} ${s.title.en} ${s.title.vi} ${s.tagline.en} ${s.tagline.vi} ${s.intro.en}`.toLowerCase()}
              >
                <SeriesCard meta={s} />
              </div>
            ))}
          </div>

          <p id="series-empty" class="text-sm text-zinc-500 hidden" data-i18n="blog.noSeriesMatch">
            No series matches that keyword.
          </p>
        </section>
      )}

      <!-- ===== Standalone articles ===== -->
      <section id="articles" class="scroll-mt-24">
        <div class="flex items-center gap-3 mb-6" data-animate>
          <h2 class="text-2xl font-bold tracking-tight text-zinc-900" data-i18n="series.articlesHeading">
            {t('series.articlesHeading')}
          </h2>
          <span
            id="result-count"
            class="px-2 py-0.5 rounded-md bg-zinc-100 border border-zinc-200 text-zinc-600 text-xs font-mono tabular-nums"
          >
            {posts.length}
          </span>
        </div>

        <!-- ===== Search + tag filter ===== -->
        <div class="mb-8 space-y-4" data-animate>
          <div class="relative max-w-md">
            <svg
              class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400 pointer-events-none"
              fill="none" stroke="currentColor" viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0" />
            </svg>
            <input
              type="search"
              id="search-input"
              class="input pl-10 pr-10"
              placeholder="Search articles…"
              data-i18n-ph="blog.searchPh"
              autocomplete="off"
            />
            <button
              type="button"
              id="search-clear"
              class="absolute right-2.5 top-1/2 -translate-y-1/2 w-6 h-6 rounded-md text-zinc-400 hover:text-zinc-700 hover:bg-zinc-100 hidden items-center justify-center transition-colors"
              aria-label="Clear search"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            <button
              type="button"
              data-tag=""
              class="tag-chip px-3 py-1.5 rounded-lg text-sm font-medium transition-all bg-brand-600 text-white"
            >
              <span data-i18n="blog.allTags">All</span>
            </button>
            {allTags.map(([tg, count]) => (
              <button
                type="button"
                data-tag={tg}
                class="tag-chip px-3 py-1.5 rounded-lg text-sm font-medium transition-all bg-zinc-100 text-zinc-700 hover:bg-zinc-200 hover:text-zinc-900"
              >
                {tg}
                <span class="ml-1 text-[11px] font-mono opacity-60 tabular-nums">{count}</span>
              </button>
            ))}
          </div>
        </div>

        <!-- ===== Grid ===== -->
        <div id="post-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
          {posts.map((post, i) => (
            <div
              class="post-item"
              data-tags={post.data.tags.join('|').toLowerCase()}
              data-text={`${post.data.title} ${post.data.description}`.toLowerCase()}
              data-index={i}
              hidden={i >= PAGE_SIZE}
            >
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                date={post.data.date}
                tags={post.data.tags}
                slug={post.slug}
                coverImage={post.data.coverImage}
                body={post.body}
                featured={post.data.featured}
              />
            </div>
          ))}
        </div>

        <!-- Empty state -->
        <div id="empty-state" class="text-center py-16 hidden">
          <svg class="w-12 h-12 mx-auto text-zinc-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0" />
          </svg>
          <p class="text-zinc-600 mb-1" data-i18n="blog.noResults">No articles match your filters.</p>
          <p class="text-sm text-zinc-500 mb-5" data-i18n="blog.noResultsHint">
            Try a different keyword, or browse the learning series above.
          </p>
          <button type="button" id="reset-filters" class="btn-secondary inline-flex">
            <span data-i18n="blog.clearFilters">Clear filters</span>
          </button>
        </div>

        <!-- Show more -->
        <div class="text-center mt-10 hidden" id="more-wrap">
          <button type="button" id="show-more" class="btn-secondary inline-flex">
            <span data-i18n="blog.showMore">Show more</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ PAGE_SIZE }}>
  (function () {
    var items = Array.prototype.slice.call(document.querySelectorAll('.post-item'));
    var seriesItems = Array.prototype.slice.call(document.querySelectorAll('.series-item'));
    var seriesEmpty = document.getElementById('series-empty');
    if (!items.length) return;

    var input = document.getElementById('search-input');
    var clearBtn = document.getElementById('search-clear');
    var chips = Array.prototype.slice.call(document.querySelectorAll('.tag-chip'));
    var countEl = document.getElementById('result-count');
    var emptyEl = document.getElementById('empty-state');
    var moreWrap = document.getElementById('more-wrap');
    var moreBtn = document.getElementById('show-more');
    var resetBtn = document.getElementById('reset-filters');

    var ACTIVE = ['bg-brand-600', 'text-white'];
    var IDLE = ['bg-zinc-100', 'text-zinc-700', 'hover:bg-zinc-200', 'hover:text-zinc-900'];

    var state = { tag: '', q: '', shown: PAGE_SIZE };

    /* Đọc trạng thái từ URL để link đã chia sẻ (?tag=…&q=…) vẫn đúng */
    try {
      var sp = new URLSearchParams(location.search);
      state.tag = sp.get('tag') || '';
      state.q = sp.get('q') || '';
      if (input && state.q) input.value = state.q;
    } catch (e) {}

    function matches(el) {
      var okTag =
        !state.tag ||
        ('|' + el.getAttribute('data-tags') + '|').indexOf('|' + state.tag.toLowerCase() + '|') !== -1;
      var okText = !state.q || el.getAttribute('data-text').indexOf(state.q.toLowerCase()) !== -1;
      return okTag && okText;
    }

    function syncUrl() {
      if (!window.history || !history.replaceState) return;
      var sp = new URLSearchParams();
      if (state.tag) sp.set('tag', state.tag);
      if (state.q) sp.set('q', state.q);
      var qs = sp.toString();
      history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + '#articles');
    }

    function render() {
      var visible = 0;
      var matched = 0;

      items.forEach(function (el) {
        if (!matches(el)) {
          el.hidden = true;
          return;
        }
        matched++;
        if (visible < state.shown) {
          el.hidden = false;
          visible++;
        } else {
          el.hidden = true;
        }
      });

      /* Tim kiem ap ca cho series: go "linux" thi thay ngay series Linux.
         Tag chi ap cho bai le, vi tag cua series khac he thong. */
      var seriesMatched = 0;
      seriesItems.forEach(function (el) {
        var ok = !state.q || el.getAttribute('data-text').indexOf(state.q.toLowerCase()) !== -1;
        el.hidden = !ok;
        if (ok) seriesMatched++;
      });
      if (seriesEmpty) seriesEmpty.classList.toggle('hidden', seriesMatched !== 0 || !state.q);

      if (countEl) countEl.textContent = String(matched);
      if (emptyEl) emptyEl.classList.toggle('hidden', matched !== 0);
      if (moreWrap) moreWrap.classList.toggle('hidden', matched <= visible);

      chips.forEach(function (c) {
        var on = (c.getAttribute('data-tag') || '') === state.tag;
        ACTIVE.forEach(function (cls) { c.classList.toggle(cls, on); });
        IDLE.forEach(function (cls) { c.classList.toggle(cls, !on); });
        c.setAttribute('aria-pressed', String(on));
      });

      if (clearBtn) {
        clearBtn.classList.toggle('hidden', !state.q);
        clearBtn.classList.toggle('flex', !!state.q);
      }
    }

    chips.forEach(function (c) {
      c.addEventListener('click', function () {
        state.tag = c.getAttribute('data-tag') || '';
        state.shown = PAGE_SIZE;
        render();
        syncUrl();
      });
    });

    var timer;
    input &&
      input.addEventListener('input', function () {
        clearTimeout(timer);
        timer = setTimeout(function () {
          state.q = input.value.trim();
          state.shown = PAGE_SIZE;
          render();
          syncUrl();
        }, 180);
      });

    clearBtn &&
      clearBtn.addEventListener('click', function () {
        if (input) input.value = '';
        state.q = '';
        state.shown = PAGE_SIZE;
        render();
        syncUrl();
        input && input.focus();
      });

    moreBtn &&
      moreBtn.addEventListener('click', function () {
        state.shown += PAGE_SIZE;
        render();
      });

    resetBtn &&
      resetBtn.addEventListener('click', function () {
        state.tag = '';
        state.q = '';
        state.shown = PAGE_SIZE;
        if (input) input.value = '';
        render();
        syncUrl();
      });

    render();
  })();
</script>
