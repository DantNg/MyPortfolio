---
/**
 * Trang một bài học của series (trong tab Blog).
 * Render CẢ hai bản ngôn ngữ trong hai khối [data-lang-block]; khối không khớp
 * ngôn ngữ hiện tại bị ẩn bằng thuộc tính `hidden` (LanguageProvider xử lý).
 * Nhờ vậy chuyển ngữ là tức thì và không cần tải lại trang.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TableOfContents from '../../../../components/TableOfContents.astro';
import ViewCounter from '../../../../components/ViewCounter.astro';
import { SERIES, getSeries } from '../../../../series';
import { getSeriesLessons } from '../../../../utils/seriesData';
import { t } from '../../../../i18n';
import { url } from '../../../../utils/url';

export async function getStaticPaths() {
  const paths = [];

  for (const s of SERIES) {
    const lessons = await getSeriesLessons(s.id);
    lessons.forEach((group, i) => {
      paths.push({
        params: { series: s.id, slug: group.slug },
        props: {
          group,
          prev: i > 0 ? lessons[i - 1] : null,
          next: i < lessons.length - 1 ? lessons[i + 1] : null,
          total: lessons.length,
        },
      });
    });
  }

  return paths;
}

const { series: seriesId } = Astro.params;
const { group, prev, next, total } = Astro.props;
const meta = getSeries(seriesId!)!;

const en = group.en;
const vi = group.vi;

const rendered = {
  en: en ? await en.render() : null,
  vi: vi ? await vi.render() : null,
};

const headings = (rendered.en?.headings ?? []).filter((h: any) => h.depth <= 3);
const hasToc = headings.length > 2;

const ContentEn = rendered.en?.Content;
const ContentVi = rendered.vi?.Content;

const seriesUrl = url(`/blog/series/${meta.id}`);
---

<BaseLayout
  title={en?.data.title ?? vi?.data.title}
  description={en?.data.description ?? vi?.data.description}
  type="article"
  tags={en?.data.tags ?? []}
>
  <article class="pt-28 pb-16 md:pt-32 md:pb-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class={hasToc ? 'lg:grid lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-14' : ''}>
      <div class="min-w-0">

      <!-- Header -->
      <header class="mb-12">
        <nav class="flex flex-wrap items-center gap-2 text-sm text-zinc-500 mb-6">
          <a href={url('/blog')} class="hover:text-brand-600 transition-colors" data-i18n="nav.blog">{t('nav.blog')}</a>
          <span>/</span>
          <a href={seriesUrl} class="hover:text-brand-600 transition-colors">
            <span data-lang-block="en">{meta.title.en}</span>
            <span data-lang-block="vi" hidden>{meta.title.vi}</span>
          </a>
        </nav>

        <div class="flex items-center gap-3 text-sm text-zinc-500 mb-4 font-mono">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-md bg-brand-50 border border-brand-200 text-brand-700 font-medium">
            <span data-i18n="series.lesson">{t('series.lesson')}</span>&nbsp;{group.lesson}&nbsp;/&nbsp;{total}
          </span>
          <span>·</span>
          <span data-lang-block="en">{en?.data.duration}</span>
          <span data-lang-block="vi" hidden>{vi?.data.duration}</span>
          <ViewCounter class="ml-1" />
        </div>

        <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-zinc-900 text-balance mb-4">
          <span data-lang-block="en">{en?.data.title}</span>
          <span data-lang-block="vi" hidden>{vi?.data.title}</span>
        </h1>

        <p class="text-lg text-zinc-600 leading-relaxed">
          <span data-lang-block="en">{en?.data.description}</span>
          <span data-lang-block="vi" hidden>{vi?.data.description}</span>
        </p>

        <div class="flex flex-wrap gap-2 mt-5">
          {(en?.data.tags ?? []).map((tag: string) => <span class="tag">#{tag}</span>)}
        </div>

        <p class="mt-6 flex items-start gap-2 text-sm text-brand-800 bg-brand-50 border border-brand-200 rounded-lg px-4 py-3">
          <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
          </svg>
          <span data-i18n="series.langHint">{t('series.langHint')}</span>
        </p>
      </header>

      <!-- Body -->
      <div>
        <div class="min-w-0">
          {ContentEn && (
            <div data-lang-block="en" class="prose prose-zinc max-w-none prose-custom">
              <ContentEn />
            </div>
          )}
          {ContentVi && (
            <div data-lang-block="vi" hidden class="prose prose-zinc max-w-none prose-custom">
              <ContentVi />
            </div>
          )}
        </div>

      </div>

      <!-- Prev / Next -->
      <nav class="mt-16 pt-8 border-t border-zinc-200 grid sm:grid-cols-2 gap-4">
        {prev ? (
          <a href={url(`/blog/series/${meta.id}/${prev.slug}`)} class="group rounded-xl border border-zinc-200 bg-white p-4 hover:border-brand-300 transition-colors">
            <span class="block text-xs text-zinc-500 mb-1" data-i18n="series.prev">{t('series.prev')}</span>
            <span class="block font-medium text-zinc-900 group-hover:text-brand-700 transition-colors text-sm">
              <span data-lang-block="en">{prev.en?.data.title}</span>
              <span data-lang-block="vi" hidden>{prev.vi?.data.title}</span>
            </span>
          </a>
        ) : <span />}

        {next && (
          <a href={url(`/blog/series/${meta.id}/${next.slug}`)} class="group rounded-xl border border-zinc-200 bg-white p-4 hover:border-brand-300 transition-colors sm:text-right">
            <span class="block text-xs text-zinc-500 mb-1" data-i18n="series.next">{t('series.next')}</span>
            <span class="block font-medium text-zinc-900 group-hover:text-brand-700 transition-colors text-sm">
              <span data-lang-block="en">{next.en?.data.title}</span>
              <span data-lang-block="vi" hidden>{next.vi?.data.title}</span>
            </span>
          </a>
        )}
      </nav>

      <div class="mt-8">
        <a href={seriesUrl} class="btn-secondary inline-flex">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
          </svg>
          <span data-i18n="series.back">{t('series.back')}</span>
        </a>
      </div>

      </div>

      {hasToc && (
        <aside class="hidden lg:block">
          <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
            <TableOfContents headings={headings} />
          </div>
        </aside>
      )}
      </div>
    </div>
  </article>
</BaseLayout>
