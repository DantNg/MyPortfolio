---
/**
 * Bài học, bản TIẾNG ANH — URL không có tiền tố.
 * Bản tiếng Việt ở src/pages/vi/blog/series/[series]/[slug].astro.
 * Toàn bộ phần render nằm trong LessonArticle để hai route không lệch nhau.
 */
import LessonArticle from '../../../../components/LessonArticle.astro';
import { getSeries } from '../../../../series';
import { lessonPaths } from '../../../../utils/seriesData';

export async function getStaticPaths() {
  return lessonPaths();
}

const { series: seriesId } = Astro.params;
const { group, prev, next, total } = Astro.props;
const meta = getSeries(seriesId!)!;
---

<LessonArticle lang="en" meta={meta} group={group} prev={prev} next={next} total={total} />
