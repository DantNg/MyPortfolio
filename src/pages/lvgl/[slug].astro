---
/**
 * Chuyển hướng: /lvgl/<slug> -> /blog/series/lvgl/<slug>
 * Giữ cho các link đã publish trước khi dời series vào tab Blog vẫn hoạt động.
 */
import { getSeriesLessons } from '../../utils/seriesData';
import { url } from '../../utils/url';

export async function getStaticPaths() {
  const lessons = await getSeriesLessons('lvgl');
  return lessons.map((l) => ({ params: { slug: l.slug } }));
}

const { slug } = Astro.params;
const target = url(`/blog/series/lvgl/${slug}`);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>Redirecting to <a href={target}>{target}</a>…</p>
    <script is:inline define:vars={{ target }}>window.location.replace(target);</script>
  </body>
</html>
