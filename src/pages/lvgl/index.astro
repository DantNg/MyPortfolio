---
/**
 * Chuyển hướng: /lvgl -> /blog/series/lvgl
 * Series đã được dời vào tab Blog; giữ trang này để link cũ không chết.
 */
import { url } from '../../utils/url';

const target = url('/blog/series/lvgl');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>Redirecting to <a href={target}>{target}</a>…</p>
    <script is:inline define:vars={{ target }}>window.location.replace(target);</script>
  </body>
</html>
